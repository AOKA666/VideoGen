FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        fontconfig \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/api/requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.txt

COPY services/api /app/services/api
COPY assets/DouyinSansBold.otf /app/assets/DouyinSansBold.otf
COPY assets/龚帆怒放体.ttf /app/assets/龚帆怒放体.ttf
COPY 二创提示词.txt /app/services/api/二创提示词.txt
COPY 带书提示词.txt /app/services/api/带书提示词.txt

RUN useradd --create-home --uid 10001 videogen \
    && mkdir -p /app/storage /app/services/api/logs \
    && chown -R videogen:videogen /app

USER videogen
WORKDIR /app/services/api

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)" || exit 1

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
