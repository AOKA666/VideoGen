# Cloudflare R2 private material library
R2_ENABLED=true
R2_ACCOUNT_ID=08580c63d6ce3edd2f923ee05aa43eff
R2_BUCKET_NAME=autogen
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://08580c63d6ce3edd2f923ee05aa43eff.r2.cloudflarestorage.com

# MiniMax image recognition for the material library
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_ENDPOINT=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=MiniMax-M3
MINIMAX_ANALYSIS_TIMEOUT_SECONDS=120
MINIMAX_AI_SCRIPT_TIMEOUT_SECONDS=300

# Concurrent Ark/Seedream requests when storyboard material source is AI-only.
# Defaults to 3 and is capped at 8 by the API.
AI_IMAGE_CONCURRENCY=3

# Optional secondary web-image channel. When configured, Brave candidates are
# merged with the selected primary channel before visual reranking.
BRAVE_SEARCH_API_KEY=

# Video material ingestion (FFmpeg + MiniMax key-frame tagging)
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_SCENE_THRESHOLD=0.32
VIDEO_CLIP_MIN_SECONDS=3
VIDEO_CLIP_MAX_SECONDS=15
VIDEO_MAX_CLIPS=60
VIDEO_PROXY_CRF=27
ASSET_UPLOAD_MAX_MB=2048

# Local WhisperX forced alignment for music lyric/subtitle timing
LYRIC_ALIGNMENT_PROVIDER=whisperx
WHISPERX_COMMAND=C:\Users\18441\whisperx-env\Scripts\whisperx.exe
WHISPERX_MODEL=small
WHISPERX_LANGUAGE=zh
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8

# Replicate WhisperX cloud alignment. Set LYRIC_ALIGNMENT_PROVIDER=replicate_whisperx to use it.
REPLICATE_API_TOKEN=
REPLICATE_WHISPERX_MODEL=victor-upmeet/whisperx:655845d6190ef70573c669245f245892cd039df4b880a1e3a65852c09252f5cc
REPLICATE_WHISPERX_LANGUAGE=zh
REPLICATE_WHISPERX_BATCH_SIZE=64
REPLICATE_WHISPERX_DIARIZATION=false
