# MiniMax copywriting and storyboard prompts
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_ENDPOINT=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=MiniMax-M3
MINIMAX_AI_SCRIPT_TIMEOUT_SECONDS=300

# DeepSeek for the optional history-copy model selector
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI for the optional history-copy model selector
OPENAI_API_KEY=your_openai_api_key
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_API_KEY=your_openai_image_api_key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=720x1280
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=jpeg
OPENAI_IMAGE_COMPRESSION=85

# Concurrent Ark/Seedream requests when storyboard material source is AI-only.
# Defaults to 3 and is capped at 8 by the API.
AI_IMAGE_CONCURRENCY=5
