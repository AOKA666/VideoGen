# Runtime
VIDEOGEN_BIND_ADDRESS=127.0.0.1
VIDEOGEN_HTTP_PORT=8080
VIDEOGEN_SUBTITLE_FONT_FILE=/app/assets/DouyinSansBold.otf
VIDEOGEN_SUBTITLE_FONT_NAME=Douyin Sans
VIDEOGEN_TITLE_FONT_FILE=/app/assets/龚帆怒放体.ttf
VIDEOGEN_TITLE_FONT_NAME=gongfannufangti

# MiniMax
MINIMAX_API_KEY=
MINIMAX_ENDPOINT=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=MiniMax-M3
MINIMAX_AI_SCRIPT_TIMEOUT_SECONDS=300

# DeepSeek (optional history-copy model)
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI (optional history-copy and image-generation models; use separate keys)
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=720x1280
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=jpeg
OPENAI_IMAGE_COMPRESSION=85

# Ark / Seedream
ARK_API_KEY=
ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_IMAGE_EDIT_MODEL=doubao-seedream-4-0-250828
AI_IMAGE_CONCURRENCY=5

# Volcengine TTS
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_KEY=
VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_CLONED_RESOURCE_ID=seed-icl-2.0
VOLC_TTS_VOICE=zh_male_dongfanghaoran_uranus_bigtts
VOLC_TTS_API_KEY=
VOLC_TTS_APP_KEY=
