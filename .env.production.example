# Runtime
VIDEOGEN_BIND_ADDRESS=127.0.0.1
VIDEOGEN_HTTP_PORT=8080
VIDEOGEN_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc

# Cloudflare R2 private material library
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_ENDPOINT=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=MiniMax-M3
MINIMAX_ANALYSIS_TIMEOUT_SECONDS=120
MINIMAX_AI_SCRIPT_TIMEOUT_SECONDS=300

# Ark / Seedream
ARK_API_KEY=
ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_IMAGE_EDIT_MODEL=doubao-seedream-4-0-250828
AI_IMAGE_CONCURRENCY=3

# Image search
BRAVE_SEARCH_API_KEY=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
WEB_IMAGE_CONCURRENCY=6

# Volcengine TTS
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_KEY=
VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_CLONED_RESOURCE_ID=seed-icl-2.0
VOLC_TTS_VOICE=zh_male_dongfanghaoran_uranus_bigtts
VOLC_TTS_API_KEY=
VOLC_TTS_APP_KEY=

# Alignment
LYRIC_ALIGNMENT_PROVIDER=replicate_whisperx
REPLICATE_API_TOKEN=
REPLICATE_WHISPERX_MODEL=victor-upmeet/whisperx:655845d6190ef70573c669245f245892cd039df4b880a1e3a65852c09252f5cc
REPLICATE_WHISPERX_LANGUAGE=zh
REPLICATE_WHISPERX_BATCH_SIZE=64
REPLICATE_WHISPERX_DIARIZATION=false

# Upload and video processing
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_SCENE_THRESHOLD=0.32
VIDEO_CLIP_MIN_SECONDS=3
